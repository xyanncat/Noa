# Noa AI Engine runtime configuration (copy to .env locally; never commit real secrets)
NOA_DEBUG=true
NOA_API_AUTH_ENABLED=false
NOA_API_KEY=replace-with-a-long-random-secret
NOA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NOA_RATE_LIMIT_PER_MINUTE=60
NOA_ENABLE_UNSAFE_TOOLS=false
NOA_ALLOWED_TERMINAL_COMMANDS=python,pytest,git
NOA_LLM_PROVIDER=auto
NOA_PROVIDER_FALLBACK_ORDER=ollama,nara_router,openrouter,nvidia_nim,cloudflare,gemini,openai
NOA_ENABLE_OLLAMA=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (OpenAI-compatible; choose a currently available free model when applicable)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Noa AI Engine

# NVIDIA NIM. Use a local NIM endpoint such as http://localhost:8000/v1 for self-hosted inference.
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Cloudflare Workers AI (or set CLOUDFLARE_BASE_URL to an AI Gateway-compatible endpoint).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_BASE_URL=

# NaraRouter (OpenAI-compatible)
NARA_ROUTER_API_KEY=
NARA_ROUTER_MODEL=auto/bynara
NARA_ROUTER_BASE_URL=https://router.bynara.id/v1

# Any other OpenAI-compatible router
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=
CUSTOM_OPENAI_BASE_URL=

# Vite client configuration. Do not expose a production API secret through VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_NOA_API_KEY=
